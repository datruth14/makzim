# Vercel KV (Redis) - For persisting admin updates on Vercel
# Required for production deployment on Vercel
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Storage > KV Database
# 4. Create a KV database or connect existing one
# 5. Copy these values from "Connect" > ".env.local"
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
