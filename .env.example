# Vercel KV (Redis)
# Required for production deployment on Vercel
# Get your KV connection string from Vercel Dashboard:
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Storage > KV Database (Create one if needed)
# 4. Copy the connection string and set these variables
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# GitHub API (for auto-committing content updates)
# Required for admin updates to persist on Vercel
# 1. Go to https://github.com/settings/tokens
# 2. Create a new token with 'repo' scope
# 3. Set GITHUB_TOKEN to your token
# 4. Set GITHUB_REPO to 'owner/repo' format
GITHUB_TOKEN=
GITHUB_REPO=datruth14/makzim
